@startuml C1_B
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
title АгроТех Х — C4 — B · Анализ на сервере фермы
Person(operator, "Дежурный оператор", "Контроль и мониторинг фермы")
Person(manager, "Руководитель", "Информация о ферме")
Person(admin, "Администратор", "Фермы, устройства, права и настройки")
System(platform, "Мониторинг свиноферм — НОВАЯ", "Центр и агенты ферм. Видео анализируется на GPU-сервере фермы, он же формирует тревоги и управляет оборудованием. Автономная работа без интернета.")
System_Ext(cameras, "Видеонаблюдение", "Камеры различных производителей.")
System_Ext(equipment, "Оборудование фермы", "Контроллеры кормушек, поилок, фильтрации и датчиков запасов. Совместимость проверить.")
System_Ext(notify, "Каналы оповещения", "GSM-шлюз (SMS, звонки), сирены и световые сигналы, push-сервисы. GSM работает без интернета и Wi-Fi")
System_Ext(erp, "ERP 1С:Агро — существующая", "Складские остатки, поступления и расход")
System_Ext(data, "Платформа данных — существующая", "Корпоративный контур хранения и аналитики")
Rel(operator, platform, "Команды и подтверждения")
Rel(platform, operator, "Тревоги и состояние в локальном интерфейсе")
Rel(platform, notify, "Тревоги и эскалации")
Rel(notify, operator, "SMS, звонок, сигнал в помещении")
Rel(manager, platform, "Запросы")
Rel(platform, manager, "Сводки и история")
Rel(admin, platform, "Настройка ферм, устройств и прав")
Rel(cameras, platform, "Видеопотоки")
Rel(platform, equipment, "Команды")
Rel(equipment, platform, "Состояние и измерения")
Rel(platform, erp, "Фактический расход")
Rel(erp, platform, "Остатки и поступления")
Rel(platform, data, "События, метрики, выбранные видеофрагменты")
@enduml
